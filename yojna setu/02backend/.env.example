# Application Settings
PROJECT_NAME="YojnaSetu API"
ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="yojnasetu_db"
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/yojnasetu_db"

# AI Provider Settings
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="auto"

# Google Authentication (OAuth 2.0 / OpenID Connect - GIS)
GOOGLE_CLIENT_ID=""

# Email Provider Settings (Gmail SMTP / Standard SMTP)
EMAIL_PROVIDER="smtp" # none, smtp, console
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your-gmail-address@gmail.com"
SMTP_PASSWORD="your-gmail-16-character-app-password"
SMTP_FROM="your-gmail-address@gmail.com"
EMAIL_FROM="your-gmail-address@gmail.com"
YOJNASETU_BASE_URL="http://localhost:3000"

