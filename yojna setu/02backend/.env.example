# Application Settings
PROJECT_NAME="YojnaSetu API"
ENV="development"
DEBUG=True
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="yojnasetu_db"
DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/yojnasetu_db"

# AI Provider Settings
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER="auto"

# Email Provider Settings
EMAIL_PROVIDER="none" # none, smtp, console
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USERNAME="your-email@example.com"
SMTP_PASSWORD="your-smtp-password"
EMAIL_FROM="noreply@yojnasetu.gov.in"
